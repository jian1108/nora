# 1. LiveKit Cloud Credentials (Get these free at https://cloud.livekit.io -> Settings -> Keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LIVEKIT_AGENT_NAME=nora-receptionist

# 2. Voice Models via LiveKit Cloud Inference (Included with LiveKit Cloud - NO extra API keys needed!)
LIVEKIT_STT_MODEL=deepgram/nova-3:multi
LIVEKIT_LLM_MODEL=openai/gpt-4.1-mini
LIVEKIT_TTS_MODEL=cartesia/sonic-2:6f84f4b8-58a2-430c-8c79-688dad597532

# (Optional) Only set USE_DIRECT_PROVIDER_KEYS=true if you prefer billing your own OpenAI/Deepgram keys directly
USE_DIRECT_PROVIDER_KEYS=false
OPENAI_API_KEY=
DEEPGRAM_API_KEY=

# 3. Backend URL (Used by Python LiveKit Agent to query Scheduler, Office Hours & Save Summaries)
NORA_WEB_API_URL=http://localhost:3000

# 4. Office Configuration
OFFICE_NAME="Ori Home Improvement"
OFFICE_TIMEZONE="America/New_York"

# 5. Optional: Google Calendar 2-Way Sync (Falls back to built-in JSON/DB Scheduler if unset)
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=primary

# 6. Optional: Low-Cost Outbound SMS Provider (Defaults to built-in Dashboard Outbox Simulator if unset)
# Supported values: "outbox" | "webhook" | "telnyx" | "textbelt"
SMS_PROVIDER=outbox
SMS_API_KEY=
SMS_FROM_NUMBER=+15550001234
SMS_WEBHOOK_URL=
